#!/bin/sh
# Run an agy-readable hook with a Python 3.8+ this machine has: `run` for MessageDisplay, `run prompt` for
# UserPromptSubmit. Without Python, pass everything through untouched: this plugin hides streamed lines,
# so failing here must never hide an answer or block a prompt.
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
module=agy_readable.hook
[ "$1" = prompt ] && module=agy_readable.login
for candidate in python3 python; do
  if $candidate -c 'import sys; sys.exit(0 if sys.version_info >= (3, 8) else 1)' >/dev/null 2>&1; then
    PYTHONPATH="$root${PYTHONPATH:+:$PYTHONPATH}" exec $candidate -m $module
  fi
done
cat >/dev/null
exit 0
