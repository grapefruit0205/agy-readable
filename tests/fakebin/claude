#!/usr/bin/env python3
"""Stand-in for the Claude Code CLI as the second-pass reviewer in tests: `-p ... PROMPT` = one-shot;
`--input-format stream-json` = a waiting worker. It answers like the fake agy's review (FAKE_REVIEW or the
file named by FAKE_REVIEW_FILE: "" = nothing to fix, "fail", "sleep", "replace:OLD:NEW"). FAKE_CLAUDE_AUTH=out
answers as a signed-out Claude Code does. Every prompt is appended to FAKE_PROMPTS, and its arguments and
environment to FAKE_CLAUDE_ARGS when set."""
import json
import os
import sys
import time


def review_mode():
    rf = os.environ.get("FAKE_REVIEW_FILE")
    if rf and os.path.exists(rf):
        with open(rf, encoding="utf-8") as f:
            return f.read().strip()
    return os.environ.get("FAKE_REVIEW", "")


def answer(prompt):
    if os.environ.get("FAKE_PROMPTS"):
        with open(os.environ["FAKE_PROMPTS"], "a", encoding="utf-8") as f:
            f.write(prompt + "\n=====\n")
    r = review_mode()
    if r == "sleep":
        time.sleep(100)
    if r == "fail":
        return None
    if r.startswith("replace:"):
        _, old, new = r.split(":", 2)
        rewritten = prompt.split("\n[다시 쓴 글]\n", 1)[1].split("\n\n[의심 목록]\n", 1)[0]
        lines = [ln.replace(old, new) for ln in rewritten.splitlines() if ln.startswith("[") and old in ln]
        return "\n".join(lines) or "없음"
    return "없음"


if os.environ.get("FAKE_CLAUDE_ARGS"):
    with open(os.environ["FAKE_CLAUDE_ARGS"], "a", encoding="utf-8") as f:
        f.write(json.dumps({"argv": sys.argv[1:], "inner": os.environ.get("AGY_READABLE_INNER"),
                            "no_claude_md": os.environ.get("CLAUDE_CODE_DISABLE_CLAUDE_MDS")}) + "\n")

signed_out = os.environ.get("FAKE_CLAUDE_AUTH") == "out"

if "--input-format" in sys.argv:
    if signed_out:
        time.sleep(0.2)
        print("Not logged in · Please run /login", file=sys.stderr, flush=True)
        sys.exit(1)
    for line in sys.stdin:
        prompt = json.loads(line)["message"]["content"]
        print(json.dumps({"type": "system", "subtype": "init"}), flush=True)
        out = answer(prompt)
        time.sleep(float(os.environ.get("FAKE_GEN", "0.2")))
        if out is None:
            print(json.dumps({"type": "result", "subtype": "error_during_execution", "is_error": True,
                              "result": "API Error: 529 overloaded"}), flush=True)
        else:
            print(json.dumps({"type": "result", "subtype": "success", "is_error": False, "result": out},
                             ensure_ascii=False), flush=True)
    sys.exit(0)

if signed_out:
    print("Not logged in · Please run /login")
    sys.exit(1)
out = answer(sys.argv[-1])
if out is None:
    print("API Error: 529 overloaded", file=sys.stderr)
    sys.exit(1)
print(out)
