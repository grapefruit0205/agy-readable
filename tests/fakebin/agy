#!/usr/bin/env python3
"""Stand-in for agy in tests. `-p PROMPT` = one-shot; `--input-format stream-json` = long-lived worker.
Behaviour comes from FAKE_MODE, or from the file named by FAKE_MODE_FILE (re-read at each step)."""
import json
import os
import re
import select
import stat
import sys
import time

MF = os.environ.get("FAKE_MODE_FILE")
DIGITS = str.maketrans("0123456789", "abcdefghij")  # the marker must not add numbers the check would reject
MODEL = sys.argv[sys.argv.index("--model") + 1] if "--model" in sys.argv else "?"


def mode():
    if MF and os.path.exists(MF):
        with open(MF) as f:
            return f.read().strip()
    return os.environ.get("FAKE_MODE", "ok")


def set_mode(m):
    with open(MF, "w") as f:
        f.write(m)


def next_mode():
    """The mode for this answer. "a,b,c" is a sequence: this answer takes a, the next ones b, then c."""
    m = mode()
    if "," in m:
        m, rest = m.split(",", 1)
        set_mode(rest)
    return m


def record_prompt(prompt):
    """Every prompt, appended, so a test can see what each attempt was told."""
    if os.environ.get("FAKE_PROMPTS"):
        with open(os.environ["FAKE_PROMPTS"], "a", encoding="utf-8") as f:
            f.write(prompt + "\n=====\n")


def is_review(prompt):
    return "\n[다시 쓴 글]\n" in prompt


def review_mode():
    """What the second pass does: the file named by FAKE_REVIEW_FILE (daemon workers keep the daemon's
    environment), else FAKE_REVIEW."""
    rf = os.environ.get("FAKE_REVIEW_FILE")
    if rf and os.path.exists(rf):
        with open(rf, encoding="utf-8") as f:
            return f.read().strip()
    return os.environ.get("FAKE_REVIEW", "")


def review_answer(prompt):
    """The second pass, as review_mode() says: "" = nothing to fix; "fail"; "sleep";
    "replace:OLD:NEW" = every numbered sentence with OLD in it, sent back with OLD replaced by NEW."""
    r = review_mode()
    if r == "sleep":
        time.sleep(100)
    if r.startswith("replace:"):
        _, old, new = r.split(":", 2)
        rewritten = prompt.split("\n[다시 쓴 글]\n", 1)[1].split("\n\n[의심 목록]\n", 1)[0]
        lines = [ln.replace(old, new) for ln in rewritten.splitlines() if ln.startswith("[") and old in ln]
        return "\n".join(lines) or "없음"
    return "없음"


def body_of(prompt):
    return prompt.split("---\n", 1)[1] if "---\n" in prompt else prompt


def record(body):
    if os.environ.get("FAKE_RECORD"):
        with open(os.environ["FAKE_RECORD"], "w", encoding="utf-8") as f:
            f.write(body)


def emit(ev):
    print(json.dumps(ev, ensure_ascii=False), flush=True)


# signing in, like agy: signed out unless FAKE_AUTH_FILE (when set) says "ok"
AUTH = os.environ.get("FAKE_AUTH_FILE")
GOOD_CODE = "4/0AgoodFakeCode" + "x" * 30


def signed_in():
    if not AUTH:
        return True
    with open(AUTH) as f:
        return f.read().strip() == "ok"


def err(text):
    sys.stderr.write(text + "\n")
    sys.stderr.flush()


def sign_in_or_exit():
    """Print mode: with a pipe as stdin agy gives up; otherwise it shows a URL and waits for the code."""
    if stat.S_ISFIFO(os.fstat(0).st_mode):
        err("Error: authentication required. Run 'agy' to log in, then retry.")
        err("error: authentication failed or timed out")
        sys.exit(1)
    wait = float(os.environ.get("FAKE_LOGIN_WAIT", "60"))
    time.sleep(float(os.environ.get("FAKE_LOGIN_DELAY", "0")))  # agy slow to start
    err("Authentication required. Please visit the URL to log in:")
    err(f"  https://accounts.google.com/o/oauth2/auth?client_id=fake&state={os.getpid()}")
    err("")
    err(f"Waiting for authentication (timeout {wait:g}s)...")
    err("Or, paste the authorization code here and press Enter:")
    ready, _, _ = select.select([sys.stdin], [], [], wait)
    if not ready:
        err("Error: authentication timed out.")
        err("error: authentication failed or timed out")
        sys.exit(1)
    if sys.stdin.readline().strip() != GOOD_CODE:
        err('Error: authentication failed: token exchange failed: oauth2: "invalid_grant" "Bad Request"')
        err("error: authentication failed or timed out")
        sys.exit(1)
    with open(AUTH, "w") as f:
        f.write("ok")


if "--input-format" in sys.argv:
    if not signed_in():
        time.sleep(0.3)
        err("Error: authentication required. Run 'agy' to log in, then retry.")
        emit({"event": "result", "result": {"status": "ERROR", "error": "authentication failed or timed out"}})
        sys.exit(1)
    if os.environ.get("FAKE_PIDS"):  # lets a test count only its own workers
        open(os.path.join(os.environ["FAKE_PIDS"], str(os.getpid())), "w").close()
    if mode() == "stuckonce":  # this process hangs before init, like agy stuck in a backend wait; later ones are fine
        set_mode("ok")
        time.sleep(100)
    time.sleep(float(os.environ.get("FAKE_STARTUP", "0.5")))
    if mode() == "startfail":
        emit({"event": "result", "result": {"status": "ERROR", "error": "Eligibility check failed: UNAVAILABLE (code 503)"}})
        sys.exit(1)
    emit({"event": "init", "conversation_id": "c"})
    turn = 0
    for line in sys.stdin:
        prompt = json.loads(line)["message"]["content"]
        turn += 1
        if is_review(prompt):
            record_prompt(prompt)
            if review_mode() == "fail":
                emit({"event": "result", "result": {"status": "ERROR", "error": "UNAVAILABLE (code 503)"}})
                sys.exit(1)
            time.sleep(float(os.environ.get("FAKE_GEN", "0.2")))
            emit({"event": "result", "result": {"status": "SUCCESS", "response": review_answer(prompt)}})
            continue
        body = body_of(prompt)
        record(body)
        record_prompt(prompt)
        m = next_mode()
        if m in ("slowonce", "failonce"):  # only the first worker to get a message misbehaves
            set_mode("ok")
        if m in ("slowonce", "hang"):
            time.sleep(100)
        if m in ("failonce", "fail"):
            emit({"event": "result", "result": {"status": "ERROR", "error": "UNAVAILABLE (code 503)"}})
            sys.exit(1)
        time.sleep(float(os.environ.get("FAKE_GEN", "0.2")))
        if m == "dropnum":
            body = body.replace("1,024", "천여")
        emit({"event": "result", "result": {"status": "SUCCESS", "usage": {"input_tokens": 14500},
                                            "response": f"[다듬음 pid={os.getpid()} turn={turn} model={MODEL}]".translate(DIGITS) + "\n" + body}})
    sys.exit(0)

prompt = sys.argv[sys.argv.index("-p") + 1]
if not signed_in():
    sign_in_or_exit()
if is_review(prompt):  # takes no mode, so a sequence in FAKE_MODE_FILE still counts only rewrites
    record_prompt(prompt)
    if review_mode() == "fail":
        sys.stderr.write("boom\n")
        sys.exit(1)
    print(review_answer(prompt))
    sys.exit(0)
body = body_of(prompt)
record(body)
record_prompt(prompt)
m = next_mode()
if m == "fail":
    sys.stderr.write("boom\n")
    sys.exit(1)
if m == "sleep":
    time.sleep(100)
if m == "dropnum":
    body = body.replace("1,024", "천여")
if m == "listbullets":
    body = re.sub(r"(?m)^\d+\. ", "- ", body)
if m == "droptoken":
    body = body.replace("⟦0⟧", "", 1)
if m == "addpath":  # a path the original never had
    body = body.replace("캐시를 확인하고", "캐시를 cache/app/now 에서 확인하고")
out = f"[다듬음 model={MODEL}]".translate(DIGITS) + "\n" + body
if m == "fence":
    out = "```markdown\n" + out + "\n```"
print(out)
