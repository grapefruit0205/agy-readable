#!/bin/sh
# `agy-readable status | log | stop`. Claude Code puts a plugin's bin/ directory on the Bash
# tool's PATH, so this also runs from inside a session.
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd -- "$root" || exit 1  # see hooks/run
for candidate in python3 python py; do  # see hooks/run
  if $candidate -c 'import sys; sys.exit(0 if sys.version_info >= (3, 8) else 1)' >/dev/null 2>&1; then
    PYTHONUTF8=1 PYTHONPATH="$root${PYTHONPATH:+:$PYTHONPATH}" exec $candidate -m agy_readable.cli "$@"
  fi
done
echo "agy-readable: Python 3.8 or newer is required" >&2
exit 1
